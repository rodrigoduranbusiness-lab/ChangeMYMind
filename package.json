{
  "name": "common-ground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A voice debate app that measures and reduces political polarization.",
  "license": "ISC",
  "scripts": {
    "dev": "npm run sync:shared && vite",
    "build": "npm run sync:shared && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-commonground \"vitest run --config vitest.emulator.config.ts\"",
    "sync:shared": "node scripts/sync-shared.mjs",
    "emulators": "firebase emulators:start",
    "judge:harness": "npm --prefix functions run harness",
    "deploy": "npm run build && firebase deploy",
    "setup:auth-recaptcha": "node scripts/ensure-auth-recaptcha.mjs"
  },
  "dependencies": {
    "computer-modern": "^0.1.3",
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
