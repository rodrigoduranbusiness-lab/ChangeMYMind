{
  "name": "common-ground-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "sync": "node ../scripts/sync-shared.mjs",
    "build": "npm run sync && tsc",
    "watch": "npm run sync && tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "harness": "npm run sync && tsx src/harness.ts",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
