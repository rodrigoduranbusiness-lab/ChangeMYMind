# Firebase web app config (safe to expose — these identify the project, they do
# not authorize access. Access is controlled by Firestore rules and App Check).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Optional. Set after Firebase Auth custom domain is connected (e.g. changemymind.tech).
# If unset, keep VITE_FIREBASE_AUTH_DOMAIN as project.firebaseapp.com and add changemymind.tech
# to Authentication → Settings → Authorized domains.
VITE_FIREBASE_AUTH_DOMAIN_CUSTOM=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI backend: vertex (default) or grok — must match Cloud Functions AI_PROVIDER.
# VITE_AI_PROVIDER=vertex

# --- Vertex (default) ---
# Gemini Live model for the voice debater (Vertex WebSocket via mintLiveAccess).
VITE_LIVE_MODEL=gemini-live-2.5-flash-native-audio
VITE_LIVE_VOICE=Charon

# --- Grok (when AI_PROVIDER=grok on functions) ---
# Set XAI_API_KEY in Functions secrets; never put it in Vite env.
# VITE_GROK_VOICE=eve

# Optional but strongly recommended in production: App Check protects the
# Firebase AI Logic endpoint from being driven by anything but your app.
# reCAPTCHA Enterprise site key.
VITE_APPCHECK_SITE_KEY=

# Point the client at local emulators (auth/firestore/functions).
VITE_USE_EMULATORS=false
